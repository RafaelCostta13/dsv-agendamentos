<% content_for :title, current_user.must_change_password? ? "Alteração de senha obrigatória" : "Alterar senha" %>
<% content_for :head do %><%= javascript_include_tag "authentication", nonce: @authentication_nonce, defer: true %><% end %>
<h1 id="auth-title"><%= current_user.must_change_password? ? "Alteração de senha obrigatória" : "Alterar senha" %></h1>
<p class="auth-intro"><%= current_user.must_change_password? ? "Por segurança, é necessário definir uma nova senha antes de continuar." : "Defina uma nova senha para sua conta." %></p>
<% if @change.errors.any? %><div class="admin-alert" role="alert"><% @change.errors.each do |error| %><p><%= error.message %></p><% end %></div><% end %>
<%= form_with scope: :password_change, url: password_path, method: :patch, class: "auth-form" do |form| %>
  <div><%= form.label :current_password, "Senha atual" %><%= form.password_field :current_password, value: nil, required: true, maxlength: 72, autocomplete: "current-password" %></div>
  <div><%= form.label :password, "Nova senha" %><%= form.password_field :password, value: nil, required: true, maxlength: 72, autocomplete: "new-password" %><small>Use pelo menos 12 caracteres.</small></div>
  <div><%= form.label :password_confirmation, "Confirmação da nova senha" %><%= form.password_field :password_confirmation, value: nil, required: true, maxlength: 72, autocomplete: "new-password" %></div>
  <%= form.submit "Alterar senha", class: "admin-button auth-submit" %>
<% end %>
<%= button_to "Sair", logout_path, method: :delete, class: "admin-button admin-button-secondary auth-logout" %>
