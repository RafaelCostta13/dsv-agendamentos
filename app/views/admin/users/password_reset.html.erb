<% content_for :title,"Redefinir senha" %>
<div class="admin-page-heading"><h1>Redefinir senha</h1></div>
<section class="admin-panel admin-detail"><p>Usuário: <strong><%= @user.name %></strong> (<%= @user.email %>).</p><%= render "errors" %>
<%= form_with scope: :user,url:password_reset_admin_user_path(@user),method: :patch,class:"admin-operation-form" do |form| %>
<%= form.hidden_field :lock_version,value:@submitted_version || @user.lock_version %>
<%= form.label :password,"Nova senha" %><%= form.password_field :password,value:nil,required:true,minlength:12,autocomplete:"new-password" %>
<%= form.label :password_confirmation,"Confirmação da nova senha" %><%= form.password_field :password_confirmation,value:nil,required:true,minlength:12,autocomplete:"new-password" %>
<%= form.label :reason,"Motivo da redefinição" %><%= form.text_area :reason,value:@reason,required:true,minlength:3,maxlength:500 %>
<p>Mínimo de 12 caracteres e máximo de 72 bytes. A troca no primeiro acesso e a invalidação de sessões serão implementadas no RF016.</p>
<div class="admin-operation-actions"><%= form.submit "Confirmar redefinição",class:"admin-button" %><%= link_to "Voltar",admin_user_path(@user),class:"admin-button admin-button-secondary" %></div>
<% end %></section>
