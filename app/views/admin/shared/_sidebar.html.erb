<aside class="admin-sidebar">
  <p class="admin-nav-title">VISÃO OPERACIONAL</p>
  <nav aria-label="Navegação administrativa">
    <%= link_to new_booking_path, class: "admin-nav-link" do %>
      <span aria-hidden="true">＋</span> Novo agendamento
    <% end %>
    <%= link_to admin_root_path(date: selected_date.iso8601), class: "admin-nav-link", aria: { current: controller_name == "dashboard" ? "page" : nil } do %>
      <span aria-hidden="true">▦</span> Dashboard
    <% end %>
    <%= link_to admin_bookings_path(date: selected_date.iso8601), class: "admin-nav-link", aria: { current: controller_name.in?(%w[bookings booking_changes]) ? "page" : nil } do %>
      <span aria-hidden="true">≡</span> Agendamentos
    <% end %>
    <%= link_to admin_slot_blocks_path(date: selected_date.iso8601), class: "admin-nav-link", aria: { current: controller_name == "slot_blocks" ? "page" : nil } do %>
      <span aria-hidden="true">▣</span> Bloqueios
    <% end %>
    <% if allowed?(:users_manage) %><%= link_to admin_users_path, class: "admin-nav-link", aria: { current: controller_name == "users" ? "page" : nil } do %>
      <span aria-hidden="true">♙</span> Usuários
    <% end %><% end %>
  </nav>
</aside>
