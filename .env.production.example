# Exemplo ilustrativo para RF018. Copie para .env.production e substitua os
# valores vazios por segredos gerados e armazenados fora do repositório.
RAILS_ENV=production
ADMIN_ACCESS_ENABLED=false
APP_HOST=dsvbooking.tech
RAILS_PORT=3000
HOST_RAILS_PORT=3000
SECRET_KEY_BASE=
RAILS_MAX_THREADS=3
PUMA_WORKERS=0
PUMA_WORKER_TIMEOUT=60
RAILS_LOG_LEVEL=info

POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=dsv_doca_agenda_production
POSTGRES_ADMIN_USER=dsv_agenda_admin
POSTGRES_ADMIN_PASSWORD=
POSTGRES_APP_USER=dsv_agenda_runtime
POSTGRES_APP_PASSWORD=
POSTGRES_MIGRATION_USER=dsv_agenda_migrator
POSTGRES_MIGRATION_PASSWORD=

# Tag imutável recomendada: versão ou SHA do commit implantado.
IMAGE_TAG=production-local

# IP /32 da interface Docker que será o peer do Nginx no host.
# Consulte `docker network inspect` após criar a rede de produção.
TRUSTED_PROXY_CIDRS=
