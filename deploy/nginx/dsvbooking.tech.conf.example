# Reference only. Install manually after DNS and the domain certificate exist.
# Keep Nginx on the host; do not add it to Docker Compose.
server_tokens off;

server {
    listen 80 default_server;
    server_name _;
    return 444;
}

server {
    listen 443 ssl default_server;
    http2 on;
    server_name _;

    ssl_certificate     /etc/letsencrypt/live/dsvbooking.tech/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/dsvbooking.tech/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    return 444;
}

server {
    listen 80;
    server_name dsvbooking.tech;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/html;
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 308 https://dsvbooking.tech$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name dsvbooking.tech;

    ssl_certificate     /etc/letsencrypt/live/dsvbooking.tech/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/dsvbooking.tech/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:DSV_TLS:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    client_max_body_size 64k;
    client_header_timeout 15s;
    client_body_timeout 15s;
    send_timeout 30s;
    keepalive_timeout 65s;

    proxy_http_version 1.1;
    proxy_set_header Host dsvbooking.tech;
    proxy_set_header X-Real-IP $remote_addr;
    # Overwrite, do not append attacker-controlled forwarding headers.
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Host dsvbooking.tech;
    proxy_set_header Connection "";
    proxy_connect_timeout 5s;
    proxy_send_timeout 30s;
    proxy_read_timeout 60s;
    proxy_request_buffering on;
    proxy_cache off;

    location = /ready {
        allow 127.0.0.1;
        allow ::1;
        deny all;
        proxy_pass http://127.0.0.1:3000;
    }

    location = /up {
        allow 127.0.0.1;
        allow ::1;
        deny all;
        proxy_pass http://127.0.0.1:3000;
    }

    location ~ (^|/)\.(?!well-known/) {
        deny all;
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
    }
}
