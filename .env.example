# Valores ilustrativos, exclusivos para desenvolvimento. Copie para .env.
RAILS_ENV=development
RAILS_PORT=3000

# Dentro do Compose, use sempre db:5432 (nenhuma porta do PostgreSQL no host).
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=dsv_doca_agenda_development
POSTGRES_USER=dsv_doca_agenda
POSTGRES_PASSWORD=change-me-development-only

# Linux/WSL: substitua pelos resultados de id -u e id -g antes do build.
LOCAL_UID=1000
LOCAL_GID=1000

# Mantenha false até a homologação de segurança e a preparação HTTPS dos RF017/RF018.
ADMIN_ACCESS_ENABLED=false
